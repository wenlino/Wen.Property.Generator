<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.0 必须保留：源生成器（Roslyn analyzer）只能加载 netstandard2.0 资产；
		     net8.0/net10.0 供 AOT 友好的消费方使用 -->
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<VersionPrefix>2.5.0</VersionPrefix>

		<AssemblyName>Wen.Property.Generator.Runtime</AssemblyName>
		<RootNamespace>Wen.Property.Generator</RootNamespace>

		<Title>Wen.Property.Generator 运行时库</Title>
		<Authors>Wenlin(5826985@qq.com)</Authors>
		<Description>Wen.Property.Generator 的共享运行时基础设施：跨程序集的属性访问器工厂与缓存，以及不认界面栈的属性读写通道（PropertyChannel）。</Description>

		<!-- AOT 兼容性声明：仅 net8.0+ 目标声明（netstandard2.0 目标不支持 AOT 分析） -->
		<IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>

		<!-- NuGet 打包配置 -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

</Project>
